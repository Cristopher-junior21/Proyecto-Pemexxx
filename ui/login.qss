QDialog { background-color: #F3F6FB; color: #18354F; font-family: "Segoe UI"; font-size: 11pt; }
QLabel#lblTitulo { font-size: 20pt; font-weight: 700; color: #123E65; }
QLabel#lblSubtitulo, QLabel#lblAviso { color: #62788E; font-size: 9pt; }
QLineEdit { background-color: #FFFFFF; border: 1px solid #C9D7E5; border-radius: 7px; padding: 7px 11px; }
QLineEdit:focus { border: 2px solid #2B668E; }
QPushButton#btnEntrar { background-color: #215F88; color: white; font-weight: 600; border: 0px; border-radius: 7px; }
QPushButton#btnEntrar:hover { background-color: #174D71; }
QPushButton#btnEntrar:pressed { background-color: #103D5D; }
